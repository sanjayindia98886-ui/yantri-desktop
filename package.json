{
  "name": "yantri-desktop",
  "version": "1.0.0",
  "main": "electron/main.js",
  "scripts": {
    "dev:vite": "vite",
    "dev:server": "node server/server.js",
    "dev:electron": "electron .",
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:server\" \"wait-on http://localhost:5173 && npm run dev:electron\"",
    "build:vite": "vite build",
    "dist": "npm run build:vite && electron-builder"
  },
  "build": {
    "appId": "com.yantri.desktop",
    "productName": "Yantri Desktop",
    "npmRebuild": false,
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/main.js",
      "electron/**/*",
      "server/**/*",
      "node_modules/sqlite3/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "html2pdf.js": "^0.14.0",
    "jsonwebtoken": "^9.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.7.2",
    "sql.js": "^1.14.1",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  }
}